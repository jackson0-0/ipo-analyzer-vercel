{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipo-analyzer",
  "account_id": "06506947b9c47e9026c287b76e7da666",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {"directory": "../frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"ipo-analyzer","database_id":"add01ca5-dcd2-4b16-a8d4-4c4cef86f878","migrations_dir":"migrations"}],
  "triggers": {"crons": ["0 * * * *", "*/5 * * * *"]},
  "vars": {"BACKGROUND_DAILY_LIMIT":"10"},
  "observability": {"enabled": true}
}
